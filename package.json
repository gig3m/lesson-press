{
  "name": "lesson-press",
  "version": "0.1.0",
  "description": "Render Pandoc-fenced-div Markdown lessons to print-quality PDF.",
  "type": "module",
  "bin": {
    "lesson-press": "dist/cli.js"
  },
  "files": ["dist/", "assets/"],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
